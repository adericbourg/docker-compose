    {
      "id": 15,
      "type": "stat",
      "title": "Call quality (MOS)",
      "description": "Estimated Mean Opinion Score (1–5) of the worst videoconference target, from a simplified ITU-T G.107 E-model: effective latency = RTT + 2 × jitter + 10 ms, R = 93.2 − latency/40 (−latency/10 beyond 160 ms) − 2.5 × loss %. Designed for voice calls — an indicator, not what Meet or Zoom report.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 4,
        "h": 8
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "min": 1,
          "max": 5,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 3.6,
                "color": "orange"
              },
              {
                "value": 4.0,
                "color": "green"
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "WITH (\n  lat = sum(rate(smokeping_response_duration_seconds_sum[5m])) by (host) / sum(rate(smokeping_response_duration_seconds_count[5m])) by (host) * 1000,\n  jit = histogram_stddev(sum(rate(smokeping_response_duration_seconds_bucket[5m])) by (host, le)) * 1000,\n  loss = clamp_min(1 - sum(rate(smokeping_response_duration_seconds_count[5m])) by (host) / sum(rate(smokeping_requests_total[5m])) by (host), 0) * 100,\n  eff = lat + 2 * jit + 10,\n  r = clamp(93.2 - eff / 40 - 0.075 * clamp_min(eff - 160, 0) - 2.5 * loss, 0, 100),\n)\nmin(1 + 0.035 * r + 0.000007 * r * (r - 60) * (100 - r))",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
